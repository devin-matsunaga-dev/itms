<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are self-executing. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Itms.Platform\Itms.Platform.csproj" />
    <ProjectReference Include="..\..\src\Itms.Contracts\Itms.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Itms.Messaging\Itms.Messaging.csproj" />
    <ProjectReference Include="..\Itms.TestSupport\Itms.TestSupport.csproj" />
    <!-- WP-0.5: the authentication criteria are about what the wire carries, so the
         suite boots the real composition root rather than a stand-in. -->
    <ProjectReference Include="..\..\src\Itms.Web.Host\Itms.Web.Host.csproj" />
    <ProjectReference Include="..\..\src\Modules\Itms.Modules.Identity\Itms.Modules.Identity.csproj" />
    <!-- WP-0.6: the tree, the subtree rewrite, and the two lookup contracts are all
         statements about what the database and the wire actually do. -->
    <ProjectReference Include="..\..\src\Modules\Itms.Modules.Directory\Itms.Modules.Directory.csproj" />
    <!-- The AppHost is referenced so its application model can be built and
         inspected. IsAspireProjectResource="false" keeps it an ordinary reference
         rather than something Aspire tries to orchestrate. -->
    <ProjectReference Include="..\..\src\Itms.AppHost\Itms.AppHost.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
