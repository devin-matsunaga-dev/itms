<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are self-executing. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- The validation filter and the ProblemDetails mapping are ASP.NET types, and
       both are testable in memory with no server, so their tests live here. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Itms.Platform\Itms.Platform.csproj" />
    <ProjectReference Include="..\..\src\Itms.Contracts\Itms.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Itms.Messaging\Itms.Messaging.csproj" />
    <ProjectReference Include="..\Itms.TestSupport\Itms.TestSupport.csproj" />
    <!-- WP-0.5: the password policy, the cookie settings, and the role policies are
         configuration, and configuration that nothing asserts is configuration that
         quietly drifts. None of these tests touches a database. -->
    <ProjectReference Include="..\..\src\Modules\Itms.Modules.Identity\Itms.Modules.Identity.csproj" />
  </ItemGroup>

</Project>
