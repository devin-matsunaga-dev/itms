  "components": {
    "schemas": {
      "AuthenticatedUserResponse": {
        "required": [
          "id",
          "userName",
          "email",
          "displayName",
          "roles",
          "departmentId",
          "locationId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The user id.",
            "format": "uuid"
          },
          "userName": {
            "type": "string",
            "description": "The sign-in name."
          },
          "email": {
            "type": "string",
            "description": "Their address."
          },
          "displayName": {
            "type": "string",
            "description": "The name shown throughout the product."
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Their roles. The client uses these to hide what a role cannot use; hiding is never the enforcement (ARCHITECTURE.md §7)."
          },
