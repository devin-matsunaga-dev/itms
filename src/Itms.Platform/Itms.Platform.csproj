<Project Sdk="Microsoft.NET.Sdk">

  <!-- The shared kernel. It references no module (ARCHITECTURE.md §3 rule 4) and
       never will; the architecture tests assert it. It does reference the ASP.NET
       shared framework, because the ProblemDetails mapping and the validation
       endpoint filter belong here rather than being rewritten in every module. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <!-- Relational only, and only for IModuleDbSession: the kernel declares the shape
         of "one connection, one transaction, shared by every context in the scope" so
         that a module can build its DbContext on it without referencing the bus, which
         ARCHITECTURE.md §3 forbids. No provider, no DbContext, no query lives here. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

</Project>
