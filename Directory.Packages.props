<Project>

  <!--
    Central package management. Package versions live here and nowhere else, so
    two projects can never disagree about a version and a bump is a one-line
    change. Individual .csproj files carry <PackageReference Include="..." />
    with no Version attribute.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Aspire hosting integrations, used only by src/Itms.AppHost. These track the
       AppHost SDK version pinned in src/Itms.AppHost/Itms.AppHost.csproj and must
       be bumped with it; ARCHITECTURE.md §10 requires `aspire update` at every
       phase gate. -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.5.3" />
  </ItemGroup>

  <!-- Aspire client integrations, used by src/Itms.Web.Host. They bind the
       Aspire-supplied connection strings and contribute the Postgres and Redis
       health checks that /health reports. Aspire.Npgsql — the bare NpgsqlDataSource,
       not the EF Core integration — is deliberate: every DbContext in this solution is
       built on the one connection IDbSession hands out, so an Aspire-registered context
       with a pool of its own would defeat the shared transaction. -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Npgsql" Version="13.5.3" />
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.5.3" />
  </ItemGroup>

  <!-- Aspire / ServiceDefaults. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.8.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
  </ItemGroup>

  <!-- Shared kernel. FluentValidation is required by CONVENTIONS.md ("validation
       with FluentValidation, executed by endpoint filter"); Itms.Platform owns the
       filter so no module has to write its own. -->
  <ItemGroup>
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>

  <!-- EF Core on PostgreSQL. ARCHITECTURE.md §4 makes EF Core the only data access
       in the solution; src/Itms.Messaging owns the first DbContext (the outbox) and
       every module DbContext follows. Design is needed by `dotnet ef migrations`
       and is PrivateAssets-only at the project that references it. -->
  <!-- ASP.NET Core Identity on EF Core (WP-0.5). Pinned to the same 10.0.3 as the
       EF Core packages above: transitive pinning is on, so a newer Identity package
       would pull an EF Core version the solution has pinned lower and turn the
       restore into an NU1605 downgrade error. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <!-- Test stack. xUnit v3 carries its own Microsoft.Testing.Platform runner, so
       there is no Microsoft.NET.Test.Sdk, no VSTest adapter, and no VSTest-based
       coverage collector here. -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <!-- Architecture rules. Consumed by tests/Itms.ArchitectureTests, which
       enforces ARCHITECTURE.md §3 by inspecting assembly references. -->
  <ItemGroup>
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <!-- In-memory HTTP host for the integration suite. WP-0.5's done-criteria are
       stated in terms of what the wire carries — a 401 rather than a redirect to an
       HTML login page, a 403 for the wrong role — and only a real request against the
       real composition root can show that. STATUS.md had pencilled this in for WP-0.9. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.3" />
  </ItemGroup>

  <!-- Integration-test infrastructure, consumed by tests/Itms.TestSupport. One
       PostgreSQL container per test assembly, reset between tests by truncation
       rather than by re-running migrations (CONVENTIONS.md). -->
  <ItemGroup>
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
  </ItemGroup>

</Project>
