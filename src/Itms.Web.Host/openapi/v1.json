{
  "openapi": "3.1.1",
  "info": {
    "title": "ITMS API",
    "description": "Unified IT Management System. Every route is versioned in its path (ARCHITECTURE.md §6), every error is an RFC 7807 problem document, and authentication is the session cookie.",
