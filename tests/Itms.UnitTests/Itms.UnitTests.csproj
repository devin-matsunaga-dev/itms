<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are self-executing. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- The validation filter and the ProblemDetails mapping are ASP.NET types, and
       both are testable in memory with no server, so their tests live here. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Itms.Platform\Itms.Platform.csproj" />
    <ProjectReference Include="..\..\src\Itms.Contracts\Itms.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Itms.Messaging\Itms.Messaging.csproj" />
    <ProjectReference Include="..\Itms.TestSupport\Itms.TestSupport.csproj" />
    <!-- WP-0.5: the password policy, the cookie settings, and the role policies are
         configuration, and configuration that nothing asserts is configuration that
         quietly drifts. None of these tests touches a database. -->
    <ProjectReference Include="..\..\src\Modules\Itms.Modules.Identity\Itms.Modules.Identity.csproj" />
    <!-- WP-0.6: the location tree's path arithmetic, depth, and placement rules are
         pure functions, so they are asserted here without a database. -->
    <ProjectReference Include="..\..\src\Modules\Itms.Modules.Directory\Itms.Modules.Directory.csproj" />
    <!-- WP-1.1: the reference-data entities own the normalisation the unique indexes
         rely on, the SLA-target invariant, and the immutability of a priority code —
         all pure, none of it needing a database. -->
    <ProjectReference Include="..\..\src\Modules\Itms.Modules.Helpdesk\Itms.Modules.Helpdesk.csproj" />
    <!-- WP-2.1: the asset tag's immutability and shape rules, the normalisation the unique
         indexes rely on, and the reference-data entities are all pure and need no
         database. -->
    <ProjectReference Include="..\..\src\Modules\Itms.Modules.Assets\Itms.Modules.Assets.csproj" />
    <!-- WP-3.1: the monitored device's reachability rule, its bounds, and the fields an
         edit deliberately cannot reach are all pure; so is the check result's
         success-carries-a-latency shape. None of it needs a database. -->
    <ProjectReference Include="..\..\src\Modules\Itms.Modules.Monitoring\Itms.Modules.Monitoring.csproj" />
    <!-- WP-0.7: the event-to-entry mapping, the diff bounds, and the coverage guard that
         keeps every domain event audited are all pure and need no database. -->
    <ProjectReference Include="..\..\src\Modules\Itms.Modules.Audit\Itms.Modules.Audit.csproj" />
  </ItemGroup>

</Project>
