<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Directory module: departments and the location tree (SPEC.md §4, §5). It
       references the shared framework because it owns endpoints, and Itms.Contracts
       because it implements IDepartmentLookup and ILocationLookup — the only way
       another module is allowed to read a department or a location. It references no
       other module, and the architecture tests assert it. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="FluentValidation" />
    <!-- Design-time only: `dotnet ef migrations` needs it, the shipped app does not. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Itms.Platform\Itms.Platform.csproj" />
    <ProjectReference Include="..\..\Itms.Contracts\Itms.Contracts.csproj" />
  </ItemGroup>

</Project>
